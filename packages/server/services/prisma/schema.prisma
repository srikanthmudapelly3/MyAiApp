


generator client {
  provider = "prisma-client-js"
   output= "../generator/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
    reviews     Review[]
    summary     summary?
}

model Review {
  id        Int      @id @default(autoincrement())
  author    String
  content   String
  rating    Int
  createdAt DateTime @default(now())
  productId Int
  product Product @relation(fields: [productId], references: [id])
}

model summary {
  id        Int      @id @default(autoincrement())
  content   String
  productId Int @unique
  product Product @relation(fields: [productId], references: [id])
  generated DateTime @default(now())
  expiresAt DateTime
}